# Use minimal base image
FROM python:3.11-slim

# Security: run as non-root
RUN useradd -m -u 1000 executor

# Install data analytics stack
RUN pip install --no-cache-dir \
    pandas==2.2.2 \
    numpy==1.26.4 \
    scipy==1.13.1 \
    scikit-learn==1.5.0 \
    statsmodels==0.14.2 \
    matplotlib==3.9.0 \
    seaborn==0.13.2 \
    plotly==5.22.0 \
    openpyxl==3.1.3 \
    xlrd==2.0.1 \
    tabulate==0.9.0 \
    pyarrow==16.0.0

# Minimal filesystem
WORKDIR /sandbox
RUN mkdir -p /script /data && chown executor:executor /script /data /sandbox

# Security hardening
USER executor
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

# Read-only entrypoint
ENTRYPOINT ["python"]
